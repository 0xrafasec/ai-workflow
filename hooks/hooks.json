{
  "description": "Fetch the tracking remote at session start and report a branch that is behind or has diverged",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-fetch.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
